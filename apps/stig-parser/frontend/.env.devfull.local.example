# Copy to .env.devfull.local (gitignored; Vite auto-loads it for --mode devfull).
# Values come from the deployed env: VITE_DEV_PROXY_TARGET is the api invoke URL
# including the stage (terraform output api_invoke_url); the Cognito values are
# the cognito_user_pool_id / cognito_client_id outputs; endpoint is the FIPS URL.
VITE_DEV_PROXY_TARGET=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=
VITE_COGNITO_ENDPOINT=
