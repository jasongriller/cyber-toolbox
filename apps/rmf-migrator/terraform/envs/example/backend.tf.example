# Copy to backend.tf (gitignored — it names real org infrastructure) and fill in.
#
# The state bucket is org-owned and must already exist (the same bucket the
# rest of the toolbox uses). Terraform state for this stack contains bucket
# names, ARNs and account ids: encrypt it and keep it in GovCloud with the
# rest of the system. Locking is S3-native (use_lockfile, Terraform >= 1.10)
# — no DynamoDB lock table needed.

terraform {
  backend "s3" {
    bucket  = "REPLACE-org-terraform-state"
    key     = "rmf-migrator/example/terraform.tfstate"
    region  = "us-gov-west-1"
    profile = "REPLACE-aws-profile"

    encrypt      = true
    use_lockfile = true
  }
}
