# Copy to terraform.tfvars (gitignored) and fill in for your environment.
#
# Every value below is a PLACEHOLDER. This root rides the toolbox's shared,
# public front door (no VPC of its own) — see main.tf for why
# network_mode = "public" / auth_mode = "cognito" are fixed there rather than
# exposed as variables here.

# Must be unique among this account's toolbox resources — the module already
# appends the account id to bucket names on top of this, so global S3
# uniqueness is handled for you.
name_prefix = "cyber-toolbox-rmf-example"

aws_region = "us-gov-west-1"

# Built by `py -3.13 scripts/build_lambda.py` (see apps/rmf-migrator/scripts/
# build_lambda.py — plain pip, cross-targeted at manylinux2014_x86_64 / cp312,
# no Docker needed). No default: filebase64sha256 fails at plan time without
# a real file at this path.
lambda_zip_path = "../../../backend/build/rmf-migrator-lambda.zip"

# Bedrock model id this deployment invokes. No default — a conscious choice;
# see apps/rmf-migrator/docs/DEPLOYMENT.md for how to validate a candidate
# model before you apply.
bedrock_model_id = "" # e.g. "openai.gpt-oss-120b-1:0" — see DEPLOYMENT.md §1 to validate a candidate first

# Shared pool (D2): both toolbox apps use ONE Cognito app client so a single
# login works across the toolbox. These defaults match the platform's
# cyber-toolbox-dev-users pool and its stig-parser-web app client — override
# only for a non-default SSM prefix or app-client name.
# cognito_ssm_prefix      = "/cyber-toolbox/dev"
# cognito_app_client_name = "stig-parser-web"

# Your org's tagging standard goes here.
tags = {
  System      = "rmf-migrator"
  Environment = "example"
}
